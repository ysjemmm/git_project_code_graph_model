## 本文件是示例，请复制为 .env（不要提交到仓库）
## 运行脚本时会自动读取项目根目录下的 .env

# Neo4j
NEO4J_URI="neo4j+s://<your-instance>.databases.neo4j.io"
NEO4J_USER="neo4j"
NEO4J_PASSWORD="replace_me"
NEO4J_DATABASE="neo4j"

# Git 缓存目录（可选）
GIT_CACHE_BASE_DIR=".cache/git_repos"

# Git 仓库（二选一：按分支 或 按 commit）
# REPO_URL="https://example.com/repo.git"
# REPO_BRANCH="master"
# 若设置 REPO_COMMIT_ID，则按该 commit 拉取（会先 clone REPO_BRANCH 再 checkout 到该 commit）
# REPO_COMMIT_ID="e9ba741b7252fa16c134ef4433128b3bb510709d"

