<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd" >
<mapper namespace="com.timevale.forward.dal.dao.BugStatusOperatorMapper">
    <select id="batchSelectByBugIds" resultType="com.timevale.forward.dal.entity.BugStatusOperatorDO">
        select * from bug_status_operator
        where bug_log_id in
        <foreach collection="bugIds" separator="," item="bugLogId" open="(" close=")">
            #{bugLogId}
        </foreach>
    </select>

</mapper>