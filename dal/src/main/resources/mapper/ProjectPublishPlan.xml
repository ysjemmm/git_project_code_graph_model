<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd" >
<!--你接口的包名是com.abc.dao,接口名是NameMapper.java，那么你的mapper.xml的namespace应该是com.abc.dao.NameMapper-->
<mapper namespace="com.timevale.forward.dal.dao.ProjectPublishPlanMapper">

    <select id="get" resultType="com.timevale.forward.dal.entity.ProjectPublishPlanDO">
        select id,project_id,publish_plan_id,create_man_id, create_man
        from project_publish_plan
        where project_id = #{projectId} and is_deleted = false order by modify_date desc
    </select>

    <insert id="batchInsert" parameterType="java.util.List">
        insert into project_publish_plan (project_id,publish_plan_id,create_man_id, create_man)
        values
        <foreach collection="list" item="i" open="" separator="," close="">
            (#{i.projectId}, #{i.publishPlanId}, #{i.createManId},#{i.createMan})
        </foreach>
    </insert>

    <update id="update" parameterType="com.timevale.forward.dal.entity.ProjectPublishPlanDO">
        update project_publish_plan
        <set>
            <if test="isDeleted != null">is_deleted = #{isDeleted},</if>
            <if test="modifyMan != null">modify_man = #{modifyMan},</if>
            <if test="modifyManId != null">modify_man_id = #{modifyManId},</if>
        </set>
        <where>
            id = #{id}
        </where>
    </update>


</mapper>
