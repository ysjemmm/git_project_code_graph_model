    <resultMap id="BaseResultMap" type="com.timevale.forward.dal.entity.ProjectMilestone">
            <id property="id" column="id" jdbcType="BIGINT"/>
            <result property="projectId" column="project_id" jdbcType="BIGINT"/>
            <result property="milestoneName" column="milestone_name" jdbcType="VARCHAR"/>
            <result property="type" column="type" jdbcType="TINYINT"/>
            <result property="stage" column="stage" jdbcType="TINYINT"/>
            <result property="relationId" column="relation_id" jdbcType="BIGINT"/>
            <result property="isDeleted" column="is_deleted" jdbcType="TINYINT"/>
            <result property="createManId" column="create_man_id" jdbcType="VARCHAR"/>
            <result property="createMan" column="create_man" jdbcType="VARCHAR"/>
            <result property="createDate" column="create_date" jdbcType="TIMESTAMP"/>
            <result property="modifyManId" column="modify_man_id" jdbcType="VARCHAR"/>
            <result property="modifyMan" column="modify_man" jdbcType="VARCHAR"/>
            <result property="modifyDate" column="modify_date" jdbcType="TIMESTAMP"/>
