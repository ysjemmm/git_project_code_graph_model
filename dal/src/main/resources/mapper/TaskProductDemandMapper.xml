<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd" >
<!--你接口的包名是com.abc.dao,接口名是NameMapper.java，那么你的mapper.xml的namespace应该是com.abc.dao.NameMapper-->
<mapper namespace="com.timevale.forward.dal.dao.TaskProductDemandMapper">

    <insert id="batchInsert" parameterType="java.util.List">
        insert into task_product_demand (task_id,product_demand_id,create_man_id, create_man)
        values
        <foreach collection="list" item="i" open="" separator="," close="">
            (#{i.taskId}, #{i.productDemandId}, #{i.createManId},#{i.createMan})
        </foreach>
    </insert>

    <select id="get" resultType="com.timevale.forward.dal.entity.TaskProductDemandDO">
        select a.id, a.task_id, a.product_demand_id, a.is_deleted
        from task_product_demand a
        <where>
            <if test="taskId != null">and a.task_id = #{taskId}</if>
            <if test="productDemandId != null">and a.product_demand_id = #{productDemandId}</if>
            and a.is_deleted=false
        </where>
    </select>

    <select id="linkProductDemandList" resultType="com.timevale.forward.dal.entity.ProductDemandListDO">
         SELECT a.id,a.name,a.priority,a.owner,a.status,a.create_man,a.create_date,b.modify_date
         FROM product_demand a
         LEFT JOIN task_product_demand b ON a.id = b.product_demand_id AND b.is_deleted = false
         where b.task_id = #{taskId}
    </select>

    <update id="update" parameterType="com.timevale.forward.dal.entity.TaskProductDemandUpdateDO">
        update task_product_demand
        <set>
            <if test="isDeleted != null">is_deleted = #{isDeleted},</if>
            <if test="modifyMan != null">modify_man = #{modifyMan},</if>
            <if test="modifyManId != null">modify_man_id = #{modifyManId},</if>
        </set>
        <where>
            <if test="updateTaskIds!=null and updateTaskIds.size()>0">
                and task_id in
                <foreach collection="updateTaskIds" item="item" separator="," open="(" close=")">
                    #{item}
                </foreach>
            </if>
            <if test="productDemandId!=null">and product_demand_id = #{productDemandId}</if>
            and is_deleted=false
        </where>
    </update>

    <select id="selectByProductDemandId" resultType="com.timevale.forward.dal.entity.TaskProductDemandDO">
        SELECT task_id, product_demand_id
        FROM task_product_demand
        WHERE product_demand_id IN
        <foreach collection="productDemandIdList" item="item" separator="," open="(" close=")">
            #{item}
        </foreach>
        AND is_deleted = false
    </select>

</mapper>
