<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd" >
<!--你接口的包名是com.abc.dao,接口名是NameMapper.java，那么你的mapper.xml的namespace应该是com.abc.dao.NameMapper-->
<mapper namespace="com.timevale.forward.dal.dao.FastSearchConditionMapper">

    <insert id="insert" parameterType="com.timevale.forward.dal.entity.FastSearchConditionDO">
        insert into fast_search_condition
            (search_user_id, search_condition_content)
        values
            (#{searchUserId}, #{searchConditionContent})
    </insert>

</mapper>