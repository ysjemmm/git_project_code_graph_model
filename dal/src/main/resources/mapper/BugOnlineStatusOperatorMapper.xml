<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd" >
<mapper namespace="com.timevale.forward.dal.dao.BugOnlineStatusOperatorMapper">

    <insert id="insert">
        insert into bug_online_status_operator(bug_online_id,status,operator,operator_id,create_man,create_man_id)
        values(#{bugOnlineStatusOperatorDO.bugOnlineId},#{bugOnlineStatusOperatorDO.status},#{bugOnlineStatusOperatorDO.operator},#{bugOnlineStatusOperatorDO.operatorId}
        ,#{createMan},#{createManId})
    </insert>

    <update id="deleteByBugOnlineId">
        update bug_online_status_operator
        set is_deleted = 1
        where bug_online_id =#{bugOnlineId}
    </update>

    <select id="selectInitInfo" resultType="Long">
        select b.id from bug_online  b left join bug_online_status_operator bo on b.id=bo.bug_online_id where  b.status=2 and b.is_deleted=false and bo.id is null limit #{limitCount}
    </select>
</mapper>