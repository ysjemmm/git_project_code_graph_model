<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd" >
<!--你接口的包名是com.abc.dao,接口名是NameMapper.java，那么你的mapper.xml的namespace应该是com.abc.dao.NameMapper-->
<mapper namespace="com.timevale.forward.dal.dao.TaskTimeMapper">

    <insert id="insert" parameterType="com.timevale.forward.dal.entity.TaskTimeDO">
        insert into task (task_id, start_date
        <if test="endDate != null">
        , end_date
        </if>
        ,create_man,create_man_id)
        values
        (#{taskId}, #{startDate}
        <if test="endDate != null">
        , #{endDate}
        </if>
        ,#{createMan},#{createManId})
    </insert>
</mapper>
