<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd" >
<!--你接口的包名是com.abc.dao,接口名是NameMapper.java，那么你的mapper.xml的namespace应该是com.abc.dao.NameMapper-->
<mapper namespace="com.timevale.forward.dal.dao.ProjectNodeMapper">

    <insert id="batchInsert" parameterType="java.util.List">
        insert into project_node (project_id,name, plan_date, actual_date , code, create_man_id, create_man)
        values
        <foreach collection="list" item="i" open="" separator="," close="">
            (#{i.projectId}, #{i.name}, #{i.planDate}, #{i.actualDate}, #{i.code}, #{createManId},#{createMan})
        </foreach>
    </insert>

    <update id="delete" parameterType="long">
        delete from project_node where project_id=#{projectId}
    </update>

    <select id="get" resultType="com.timevale.forward.dal.entity.ProjectNodeDO">
        select *
        from project_node
        <where>
            <if test="projectId!=null">and project_id = #{projectId}</if>
        </where>
    </select>

    <select id="selectByProjectIdList" resultType="com.timevale.forward.dal.entity.ProjectNodeDO">
        SELECT *
        FROM project_node
        <where>
            project_id IN
            <foreach collection="projectIdList" item="item" separator="," open="(" close=")">
                #{item}
            </foreach>
        </where>
    </select>

    <update id="updateSubmitTestActualDate">
        update project_node
        set actual_date=#{actualDate}
        where project_id=#{projectId} and name= '提测'
    </update>

    <select id="getByName" resultType="com.timevale.forward.dal.entity.ProjectNodeDO">
        SELECT id, plan_date, actual_date
        FROM project_node
        WHERE project_id = #{projectId} AND
              name = #{name}
    </select>

    <update id="updateActualDateById">
        update project_node
        set actual_date=#{actualDate}
        where id=#{id}
    </update>

    <select id="selectByCondition" resultType="com.timevale.forward.dal.entity.ProjectNodeDO">
        SELECT id,project_id,name, plan_date, actual_date
        FROM project_node
        <where>
            <if test="c.projectIds!=null and c.projectIds.size()>0">
                and project_id in
                <foreach collection="c.projectIds" item="item" separator="," open="(" close=")">
                    #{item}
                </foreach>
            </if>
            and name = #{c.nodeName}
            <if test="c.actualDateLeft!=null and c.actualDateRight!=null">
                and actual_date &gt;= #{c.actualDateLeft} and actual_date &lt;= #{c.actualDateRight}
            </if>
        </where>
    </select>

    <select id="selectByProjectIdListFilterDate" resultType="com.timevale.forward.dal.entity.ProjectNodeDO">
        SELECT id,project_id,name, plan_date, actual_date ,create_man_id, create_man
        FROM project_node
        <where>
            project_id IN
            <foreach collection="projectIdList" item="item" separator="," open="(" close=")">
                #{item}
            </foreach>
             and actual_date is null
        </where>
    </select>

    <select id="getById" resultType="com.timevale.forward.dal.entity.ProjectNodeDO">
        select id,project_id,name, plan_date, actual_date ,create_man_id, create_man
        from project_node
        <where>
            <if test="id!=null">and id = #{id}</if>
        </where>
    </select>
</mapper>
