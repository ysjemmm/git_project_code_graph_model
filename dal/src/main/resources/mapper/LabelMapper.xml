<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd" >
<!--你接口的包名是com.abc.dao,接口名是NameMapper.java，那么你的mapper.xml的namespace应该是com.abc.dao.NameMapper-->
<mapper namespace="com.timevale.forward.dal.dao.LabelMapper">

    <insert id="batchInsert" parameterType="java.util.List">
        insert into label (name,label_category_id,create_man ,create_man_id)
        values
        <foreach collection="list" item="i" open="" separator="," close="">
            (#{i.name},#{i.labelCategoryId},#{createMan},#{createManId})
        </foreach>
    </insert>

    <update id="update">
        update label
        <set>
            <if test="name != null and name != ''">name = #{name},</if>
            <if test="isDeleted != null">is_deleted = #{isDeleted},</if>
            <if test="true">
                modify_man = #{modifyMan},
                modify_man_id = #{modifyManId},
            </if>
        </set>
        <where>
            id = #{id}
        </where>
    </update>



    <select id="list" resultType="com.timevale.forward.dal.entity.LabelDO">
        select id,name,label_category_id,
        is_deleted,create_man ,create_man_id,create_date ,modify_man ,modify_man_id,modify_date
        from label a
        <where>
            <if test="id != null">and a.id = #{id}</if>
            <if test="fullCnName != null and fullCnName != ''">and a.full_cn_name like concat('%',#{fullCnName},'%')</if>
            <if test="egName != null and egName != ''">and a.eg_name like concat('%',#{egName},'%')</if>
            <if test="status!=null and status.size()>0">
                and a.status in
                <foreach collection="status" item="item" separator="," open="(" close=")">
                    #{item}
                </foreach>
            </if>
            <if test="createManIds!=null and createManIds.size()>0">
                and a.create_man_id in
                <foreach collection="createManIds" item="item" separator="," open="(" close=")">
                    #{item}
                </foreach>
            </if>
            <if test="filterTrackEventIds!=null and filterTrackEventIds.size()>0">
                and a.id not in
                <foreach collection="filterTrackEventIds" item="item" separator="," open="(" close=")">
                    #{item}
                </foreach>
            </if>
            <if test="trackEventIds!=null and trackEventIds.size()>0">
                and a.id  in
                <foreach collection="trackEventIds" item="item" separator="," open="(" close=")">
                    #{item}
                </foreach>
            </if>
            <if test="trackMapIds!=null and trackMapIds.size()>0">
                and a.track_map_id  in
                <foreach collection="trackMapIds" item="item" separator="," open="(" close=")">
                    #{item}
                </foreach>
            </if>
            <if test="createDateStart != null and createDateEnd != null">
                and a.create_date &gt;= #{createDateStart} and a.create_date &lt;= #{createDateEnd}
            </if>
            <if test="modifyDateStart != null and modifyDateEnd != null">
                and a.modify_date &gt;= #{modifyDateStart} and a.modify_date &lt;= #{modifyDateEnd}
            </if>
            and a.is_deleted=false
        </where>
    </select>

    <select id="get" resultType="com.timevale.forward.dal.entity.LabelDO">
        select id,name,label_category_id,
        is_deleted,create_man ,create_man_id,create_date ,modify_man ,modify_man_id,modify_date
        from label
        <where>
            id = #{id} and is_deleted=false
        </where>
    </select>

    <select id="getByCategoryIds" resultType="com.timevale.forward.dal.entity.LabelDO">
        select id,name,label_category_id,
        is_deleted,create_man ,create_man_id,create_date ,modify_man ,modify_man_id,modify_date
        from label
        <where>
            <if test="categoryIds!=null and categoryIds.size()>0">
                and label_category_id  in
                <foreach collection="categoryIds" item="item" separator="," open="(" close=")">
                    #{item}
                </foreach>
            </if>

             and is_deleted=false
        </where>
    </select>

    <select id="getByNameInOneCategory" resultType="com.timevale.forward.dal.entity.LabelDO">
        select id,name,label_category_id,
        is_deleted,create_man ,create_man_id,create_date ,modify_man ,modify_man_id,modify_date
        from label
        <where>
            <if test="categoryId != null">and label_category_id = #{categoryId}</if>
            <if test="names!=null and names.size()>0">
                and name  in
                <foreach collection="names" item="item" separator="," open="(" close=")">
                    #{item}
                </foreach>
            </if>
            and is_deleted=false
        </where>
    </select>


</mapper>

